<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration "installers" (stage 2 of 2).
  Signs the NSIS installer, which already contains the signed OwlTrack.exe.
  The artifact is the GitHub Actions artifact "unsigned-installers": a zip holding the setup exe.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="OwlTrack-Setup-${version}.exe" product-name="OwlTrack" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
