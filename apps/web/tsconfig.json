{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": [],
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "paths": {
      "@/*": ["./src/*"],
      "@desktop/*": ["../desktop/src/renderer/src/*"],
      "@shared/*": ["../desktop/src/shared/*"]
    }
  },
  // The desktop renderer's env.d.ts declares `window.api`, which the demo fills in.
  "include": ["src/**/*", "../desktop/src/renderer/src/env.d.ts"]
}
