{
  "name": "owltrack-monorepo",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/sefi-uzan/owltrack.git"
  },
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "check": "biome check",
    "dev": "turbo run dev",
    "dist": "turbo run dist --filter=@repo/desktop",
    "fix": "biome check --write",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "turbo": "^2.11.10",
    "ultracite": "^8.1.1"
  },
  "packageManager": "npm@11.19.0"
}
